// Delifast — Prisma schema
// Multi-vendor, multi-vertical (restaurant now, supermarket/pharmacy later)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR_STAFF
  VENDOR_OWNER
  ADMIN
  SUPER_ADMIN
}

enum VendorType {
  RESTAURANT
  SUPERMARKET
  PHARMACY
  BAKERY
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  RIDER_PICKED_UP
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
  WALLET
}

model User {
  id            String    @id @default(uuid())
  fullName      String
  phone         String    @unique
  email         String?   @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  language      String    @default("ar") // ar | en
  twoFactorSecret String?
  addresses     Address[]
  orders        Order[]
  vendorStaffOf VendorStaff[]
  adminActions  AdminAuditLog[] @relation("ActorActions")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Address {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  label     String   // "Home", "Work"
  city      String
  district  String   // e.g. "Nasr City"
  street    String
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
}

model Vendor {
  id            String      @id @default(uuid())
  name          String
  type          VendorType
  city          String
  district      String
  isApproved    Boolean     @default(false)
  isOpen        Boolean     @default(true)
  rating        Float       @default(0)
  ratingCount   Int         @default(0)
  deliveryFee   Int         // EGP, minor-unit-free for simplicity
  etaMinLabel   String?     // "15-20 MIN"
  coverImageUrl String?
  logoInitial   String?     // e.g. "Z" for badge
  categories    Category[]
  products      Product[]
  orders        Order[]
  staff         VendorStaff[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model VendorStaff {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  vendor   Vendor @relation(fields: [vendorId], references: [id])
  vendorId String
  role     Role   @default(VENDOR_STAFF)

  @@unique([userId, vendorId])
}

model Category {
  id       String    @id @default(uuid())
  vendor   Vendor    @relation(fields: [vendorId], references: [id])
  vendorId String
  name     String    // "Chargrill", "Dairy", "Produce"
  sortOrder Int      @default(0)
  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  vendorId    String
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  name        String
  description String?
  price       Int      // EGP
  imageUrl    String?
  inStock     Boolean  @default(true)
  // Vertical-specific extras without a schema change:
  // restaurant: { spiceLevel, addOns: [...] }
  // supermarket: { weightKg, brand, expiryTracked }
  attributes  Json?
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String        @id @default(uuid())
  code          String        @unique // "EG-4821"
  customer      User          @relation(fields: [customerId], references: [id])
  customerId    String
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  vendorId      String
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  items         OrderItem[]
  subtotal      Int
  deliveryFee   Int
  total         Int
  deliveryAddress Json        // snapshot at order time
  statusHistory Json[]        // [{status, at}]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  nameSnapshot  String
  priceSnapshot Int
  quantity  Int
}

// Every sensitive admin action gets logged: who, what, when.
model AdminAuditLog {
  id        String   @id @default(uuid())
  actor     User     @relation("ActorActions", fields: [actorId], references: [id])
  actorId   String
  action    String   // "VENDOR_APPROVED", "USER_SUSPENDED", "FEATURE_FLAG_TOGGLED"
  targetType String
  targetId  String
  metadata  Json?
  createdAt DateTime @default(now())
}

model FeatureFlag {
  key       String   @id // "supermarket_vertical_enabled"
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
